# Copiez ce fichier en ".env" (utilisé aussi bien par Next.js que par le script
# "npm run seed") ou configurez ces variables dans hPanel > Node.js (production,
# sur Hostinger).

NODE_ENV=production
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=lavarenne_crm
DB_USER=crmuser
DB_PASSWORD=changez_ce_mot_de_passe

# Clé secrète pour signer les sessions de connexion (JWT).
# Générez-en une longue et aléatoire, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez_cette_cle_secrete_longue_et_aleatoire

# Domaine complet du site une fois en ligne (cookies sécurisés).
APP_URL=https://votre-domaine.ma
